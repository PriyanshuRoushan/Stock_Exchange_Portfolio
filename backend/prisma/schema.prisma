// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                Int                @id @default(autoincrement())
  username          String             @db.VarChar(100)
  email             String             @unique @db.VarChar(255)
  password          String             @db.VarChar(255)
  createdAt         DateTime           @default(now()) @map("created_at") @db.Timestamp(6)
  connectedAccounts ConnectedAccount[]

  @@map("users")
}

model Broker {
  id                Int                @id @default(autoincrement())
  name              String             @unique @db.VarChar(100)
  type              String             @db.VarChar(50)
  createdAt         DateTime           @default(now()) @map("created_at") @db.Timestamp(6)
  connectedAccounts ConnectedAccount[]

  @@map("brokers")
}

model ConnectedAccount {
  id               Int       @id @default(autoincrement())
  userId           Int       @map("user_id")
  brokerId         Int       @map("broker_id")
  brokerUserName   String?   @map("broker_user_name") @db.VarChar(100)
  brokerUserId     String    @map("broker_user_id") @db.VarChar(100)
  brokerAccountNumber String? @map("broker_account_number") @db.VarChar(100)
  accessToken      String    @map("access_token")
  refreshToken     String?   @map("refresh_token")
  tokenExpiry      DateTime  @map("token_expiry") @db.Timestamp(6)
  connectionStatus String    @default("connected") @map("connection_status") @db.VarChar(20)
  lastSyncedAt     DateTime  @default(now()) @map("last_synced_at") @db.Timestamp(6)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt        DateTime  @default(now()) @map("updated_at") @db.Timestamp(6)
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  broker           Broker    @relation(fields: [brokerId], references: [id], onDelete: Cascade)
  holdings         Holding[]
  syncLogs         SyncLog[]

  @@unique([userId, brokerId])
  @@map("connected_accounts")
}

model Holding {
  id                  Int              @id @default(autoincrement())
  connectedAccountId  Int              @map("connected_account_id")
  symbol              String           @db.VarChar(50)
  companyName         String?          @map("company_name")
  isin                String?          @db.VarChar(20)
  instrumentToken     String?          @map("instrument_token") @db.VarChar(100)
  exchange            String?          @db.VarChar(10)
  quantity            Decimal          @db.Decimal(18, 4)
  averageBuyPrice     Decimal          @map("average_buy_price") @db.Decimal(18, 4)
  currentPrice        Decimal          @map("current_price") @db.Decimal(18, 4)
  investedValue       Decimal?         @map("invested_value") @db.Decimal(18, 2)
  currentValue        Decimal?         @map("current_value") @db.Decimal(18, 2)
  pnl                 Decimal?         @db.Decimal(18, 2)
  pnlPercentage       Decimal?         @map("pnl_percentage") @db.Decimal(8, 2)
  dayPnl              Decimal?         @map("day_pnl") @db.Decimal(18, 2)
  dayChangePercentage Decimal?         @map("day_change_percentage") @db.Decimal(8, 2)
  assetType           String           @map("asset_type") @db.VarChar(20)
  sector              String?          @db.VarChar(100)
  currency            String?          @default("INR") @db.VarChar(10)
  isActive            Boolean          @default(true) @map("is_active")
  lastSyncedAt        DateTime?        @map("last_synced_at") @db.Timestamp(6)
  updatedAt           DateTime         @default(now()) @map("updated_at") @db.Timestamp(6)
  connectedAccount    ConnectedAccount @relation(fields: [connectedAccountId], references: [id], onDelete: Cascade)

  @@map("holdings")
  @@index([connectedAccountId, symbol])
}

model SyncLog {
  id                 Int               @id @default(autoincrement())
  connectedAccountId Int?              @map("connected_account_id")
  status             String            @db.VarChar(20)
  message            String?
  startedAt          DateTime?          @map("started_at") @db.Timestamp(6)
  completedAt        DateTime?          @map("completed_at") @db.Timestamp(6)
  durationMs         Int?               @map("duration_ms")
  brokerResponse     Json?              @map("broker_response")
  createdAt          DateTime          @default(now()) @map("created_at") @db.Timestamp(6)
  connectedAccount   ConnectedAccount? @relation(fields: [connectedAccountId], references: [id], onDelete: SetNull)

  @@map("sync_logs")
}
